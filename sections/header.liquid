<header class="site-header" data-sticky="{{ section.settings.sticky }}">
  <div class="site-header__inner">
    <div class="site-header__left">
      <button type="button" class="site-header__menu-toggle" aria-label="Open menu" data-menu-open>
        <svg width="22" height="14" viewBox="0 0 22 14" fill="none" aria-hidden="true">
          <path d="M0 1h22M0 7h22M0 13h22" stroke="currentColor" stroke-width="1.4"/>
        </svg>
      </button>

      <nav class="site-header__nav" aria-label="Main">
        {%- assign shop_menu = section.settings.shop_menu -%}
        {%- if shop_menu != blank and shop_menu.links.size > 0 -%}
          <div class="site-header__nav-item has-dropdown">
            <a href="{{ section.settings.shop_url | default: '/collections/all' }}" class="site-header__nav-link">
              {{ section.settings.shop_label | default: 'Shop' }}
              <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
              </svg>
            </a>
            <div class="site-header__dropdown">
              <ul>
                {%- for child in shop_menu.links -%}
                  <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          </div>
        {%- else -%}
          <a href="{{ section.settings.shop_url | default: '/collections/all' }}" class="site-header__nav-link">
            {{ section.settings.shop_label | default: 'Shop' }}
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
              <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            </svg>
          </a>
        {%- endif -%}

        <a href="{{ section.settings.bestsellers_url | default: '/collections/bestsellers' }}" class="site-header__nav-link">
          {{ section.settings.bestsellers_label | default: 'Bestsellers' }}
        </a>
        <a href="{{ section.settings.bundles_url | default: '/pages/bundles' }}" class="site-header__nav-link">
          {{ section.settings.bundles_label | default: 'Bundles' }}
        </a>
      </nav>
    </div>

    <a href="{{ routes.root_url }}" class="site-header__logo">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 400 | image_tag:
          loading: 'eager',
          width: section.settings.logo.width,
          height: section.settings.logo.height,
          alt: shop.name
        }}
      {%- else -%}
        <span class="site-header__logo-text">{{ section.settings.logo_text | default: shop.name }}</span>
      {%- endif -%}
    </a>

    <div class="site-header__right">
      <a href="#" class="site-header__locale" aria-label="Region and currency">
        <span>{{ localization.country.iso_code | default: 'DE' }}</span>
        <span class="dot">·</span>
        <span>{{ cart.currency.iso_code | default: 'EUR' }} {{ cart.currency.symbol | default: '€' }}</span>
      </a>

      <a href="{{ routes.search_url }}" class="site-header__icon" aria-label="Search">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="9" cy="9" r="7" stroke="currentColor" stroke-width="1.5"/>
          <path d="M14.5 14.5L19 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </a>

      <a href="{{ routes.account_url }}" class="site-header__icon" aria-label="Account">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="10" cy="7" r="3.5" stroke="currentColor" stroke-width="1.5"/>
          <path d="M3 18c0-3.866 3.134-7 7-7s7 3.134 7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </a>

      <a href="{{ routes.cart_url }}" class="site-header__icon site-header__cart" aria-label="Cart">
        <svg width="20" height="22" viewBox="0 0 20 22" fill="none" aria-hidden="true">
          <path d="M2 6h16l-1.5 13a2 2 0 01-2 1.8H5.5a2 2 0 01-2-1.8L2 6z" stroke="currentColor" stroke-width="1.5"/>
          <path d="M7 6V4.5a3 3 0 016 0V6" stroke="currentColor" stroke-width="1.5"/>
        </svg>
        <span class="site-header__cart-count" data-cart-count="{{ cart.item_count }}">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

<aside class="site-drawer" data-drawer hidden>
  <div class="site-drawer__backdrop" data-drawer-close></div>
  <div class="site-drawer__panel" role="dialog" aria-modal="true" aria-label="Menu">
    <button type="button" class="site-drawer__close" data-drawer-close aria-label="Close menu">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M1 1l16 16M17 1L1 17" stroke="currentColor" stroke-width="1.5"/>
      </svg>
    </button>

    <nav class="site-drawer__nav">
      <a href="{{ section.settings.shop_url | default: '/collections/all' }}" class="site-drawer__link">
        {{ section.settings.shop_label | default: 'Shop' }}
        <svg width="8" height="14" viewBox="0 0 8 14" fill="none" aria-hidden="true">
          <path d="M1 1l6 6-6 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
      </a>
      <a href="{{ section.settings.bestsellers_url | default: '/collections/bestsellers' }}" class="site-drawer__link">
        {{ section.settings.bestsellers_label | default: 'Bestsellers' }}
      </a>
      <a href="{{ section.settings.bundles_url | default: '/pages/bundles' }}" class="site-drawer__link">
        {{ section.settings.bundles_label | default: 'Bundles' }}
      </a>
    </nav>

    <div class="site-drawer__locale">
      <span class="flag">🇩🇪</span>
      <span>{{ section.settings.country_label | default: 'GERMANY' }}</span>
      <span class="dot">·</span>
      <span>{{ cart.currency.iso_code | default: 'EUR' }} {{ cart.currency.symbol | default: '€' }}</span>
      <svg width="8" height="14" viewBox="0 0 8 14" fill="none" aria-hidden="true">
        <path d="M1 1l6 6-6 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      </svg>
    </div>
  </div>
</aside>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text (fallback)",
      "default": "hehku"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "text",
      "id": "shop_label",
      "label": "Shop label",
      "default": "Shop"
    },
    {
      "type": "url",
      "id": "shop_url",
      "label": "Shop link",
      "default": "/collections/all"
    },
    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "Shop dropdown menu (optional)",
      "info": "Adds a dropdown under Shop with these links."
    },
    {
      "type": "text",
      "id": "bestsellers_label",
      "label": "Bestsellers label",
      "default": "Bestsellers"
    },
    {
      "type": "url",
      "id": "bestsellers_url",
      "label": "Bestsellers link",
      "default": "/collections/bestsellers"
    },
    {
      "type": "text",
      "id": "bundles_label",
      "label": "Bundles label",
      "default": "Bundles"
    },
    {
      "type": "url",
      "id": "bundles_url",
      "label": "Bundles link",
      "default": "/pages/bundles"
    },
    {
      "type": "header",
      "content": "Drawer"
    },
    {
      "type": "text",
      "id": "country_label",
      "label": "Country label (drawer)",
      "default": "GERMANY"
    },
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Sticky header",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}
