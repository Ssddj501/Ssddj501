{%- liquid
  assign bg = section.settings.background_color | default: '#cdf2bc'
-%}

<section class="bundles-hero" style="--bundles-bg: {{ bg }};">
  <div class="bundles-hero__inner">
    {%- if section.settings.heading != blank -%}
      <h1 class="bundles-hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <div class="bundles-hero__body">{{ section.settings.body }}</div>
    {%- endif -%}
  </div>
</section>

{%- if section.blocks.size > 0 -%}
  <nav class="filter-bar bundles-filter" aria-label="Bundle filter">
    <div class="filter-bar__scroller">
      {%- for block in section.blocks -%}
        {%- liquid
          assign active_handle = collection.handle | default: ''
          assign target_handle = block.settings.collection.handle
          assign is_active = false
          if active_handle != '' and target_handle == active_handle
            assign is_active = true
          endif
        -%}
        <a
          href="{{ block.settings.collection.url | default: block.settings.link | default: '#' }}"
          class="filter-pill{% if is_active %} is-active{% endif %}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.label | default: block.settings.collection.title }}
        </a>
      {%- endfor -%}
    </div>
  </nav>
{%- endif -%}

{%- if collection and collection.products.size > 0 -%}
  <section class="collection bundles-collection">
    <div class="collection__toolbar">
      <div class="collection__toolbar-left">
        <button type="button" class="toolbar-dropdown">
          <span>{{ 'collections.general.filter' | t | default: 'Filter' }}</span>
          <span class="toolbar-dropdown__chip"><svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg></span>
        </button>
      </div>
      <div class="collection__toolbar-count">
        {{ collection.products_count }} {%- if collection.products_count == 1 %} product{% else %} products{% endif -%}
      </div>
      <div class="collection__toolbar-right">
        <form class="toolbar-sort" method="get">
          <div class="toolbar-dropdown">
            <select name="sort_by" class="toolbar-sort__select" onchange="this.form.submit()">
              {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
              <option value="best-selling" {% if current_sort == 'best-selling' %}selected{% endif %}>Best selling</option>
              <option value="manual" {% if current_sort == 'manual' %}selected{% endif %}>Featured</option>
              <option value="price-ascending" {% if current_sort == 'price-ascending' %}selected{% endif %}>Price, low to high</option>
              <option value="price-descending" {% if current_sort == 'price-descending' %}selected{% endif %}>Price, high to low</option>
            </select>
            <span class="toolbar-dropdown__chip"><svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg></span>
          </div>
        </form>
      </div>
    </div>

    <div class="product-grid">
      {%- for product in collection.products -%}
        {%- render 'product-card', product: product, card_index: forloop.index0 -%}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Bundles page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bundles"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Skip the trial-and-error with our fruit-powered skincare bundles. Curated to work better together, each set is designed to target specific skin goals — hydration, balance, glow, or barrier repair. Whether you're gifting or upgrading your own routine, these Smuuti combos deliver pro-level results (and savings) in one cute package.</p>"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Hero background color",
      "default": "#cdf2bc"
    }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Filter pill",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Custom link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundles page",
      "blocks": [
        { "type": "pill", "settings": { "label": "Toners" } },
        { "type": "pill", "settings": { "label": "Serums" } },
        { "type": "pill", "settings": { "label": "Moisturizers" } },
        { "type": "pill", "settings": { "label": "Lip Care" } }
      ]
    }
  ]
}
{% endschema %}
