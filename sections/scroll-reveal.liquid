<style>
  .scroll-reveal-section {
    background: var(--color-background, #ffffff);
    padding: 120px 28px;
    overflow: hidden;
    position: relative;
  }
  .scroll-reveal-section__inner {
    max-width: 980px;
    margin: 0 auto;
    text-align: center;
  }
  .scroll-reveal-section__eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-text);
    opacity: 0;
    transform: translate3d(0, 24px, 0);
    transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1) 0.1s, transform 1s cubic-bezier(0.16, 1, 0.3, 1) 0.1s;
    will-change: opacity, transform;
  }
  .scroll-reveal-section__heading {
    font-family: var(--font-heading);
    font-size: clamp(40px, 6vw, 76px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 22px 0 20px;
    color: var(--color-text);
    opacity: 0;
    transform: translate3d(0, 32px, 0);
    transition: opacity 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.25s, transform 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.25s;
    will-change: opacity, transform;
  }
  .scroll-reveal-section__sub {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.65;
    color: var(--color-text);
    opacity: 0.78;
    max-width: 600px;
    margin: 0 auto 60px;
    opacity: 0;
    transform: translate3d(0, 32px, 0);
    transition: opacity 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.4s, transform 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.4s;
    will-change: opacity, transform;
  }
  .scroll-reveal-section__media {
    position: relative;
    max-width: 760px;
    margin: 0 auto;
    aspect-ratio: 1/1;
    border-radius: 24px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.04);
    opacity: 0;
    transform: translate3d(0, 80px, 0) scale(0.96);
    transition: opacity 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.5s, transform 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.5s, box-shadow 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.5s;
    box-shadow: 0 0 0 rgba(0, 0, 0, 0);
    will-change: opacity, transform;
  }
  .scroll-reveal-section__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .scroll-reveal-section__media-bg-accent {
    position: absolute;
    inset: -40% -10% 60% -10%;
    background: radial-gradient(closest-side, var(--color-accent, #b8f0a0) 0%, transparent 70%);
    opacity: 0;
    transform: translate3d(0, 60px, 0) scale(0.9);
    transition: opacity 1.6s cubic-bezier(0.16, 1, 0.3, 1) 0.3s, transform 1.6s cubic-bezier(0.16, 1, 0.3, 1) 0.3s;
    pointer-events: none;
    z-index: 0;
    filter: blur(20px);
  }
  .scroll-reveal-section > * { position: relative; z-index: 1; }

  .scroll-reveal-section.is-in-view .scroll-reveal-section__eyebrow,
  .scroll-reveal-section.is-in-view .scroll-reveal-section__heading,
  .scroll-reveal-section.is-in-view .scroll-reveal-section__sub {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
  .scroll-reveal-section.is-in-view .scroll-reveal-section__sub { opacity: 0.78; }
  .scroll-reveal-section.is-in-view .scroll-reveal-section__media {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
    box-shadow: 0 60px 120px -30px rgba(0, 0, 0, 0.22);
  }
  .scroll-reveal-section.is-in-view .scroll-reveal-section__media-bg-accent {
    opacity: 0.55;
    transform: translate3d(0, 0, 0) scale(1);
  }

  @keyframes scroll-reveal-section-float {
    0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(0, -12px, 0) scale(1.006); }
  }
  .scroll-reveal-section.is-in-view .scroll-reveal-section__media {
    animation: scroll-reveal-section-float 8s ease-in-out infinite 2s;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-reveal-section__eyebrow,
    .scroll-reveal-section__heading,
    .scroll-reveal-section__sub,
    .scroll-reveal-section__media,
    .scroll-reveal-section__media-bg-accent {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
      animation: none !important;
    }
    .scroll-reveal-section__sub { opacity: 0.78 !important; }
  }

  @media (max-width: 760px) {
    .scroll-reveal-section { padding: 72px 20px; }
    .scroll-reveal-section__sub { margin-bottom: 44px; }
    .scroll-reveal-section__media { border-radius: 18px; }
  }
</style>

<section class="scroll-reveal-section" data-scroll-reveal>
  <div class="scroll-reveal-section__media-bg-accent" aria-hidden="true"></div>
  <div class="scroll-reveal-section__inner">
    {%- if section.settings.eyebrow != blank -%}
      <span class="scroll-reveal-section__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="scroll-reveal-section__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="scroll-reveal-section__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}
    <div class="scroll-reveal-section__media">
      <img src="{{ section.settings.image_url }}" alt="{{ section.settings.image_alt | default: 'SOVÈNE Relief Patch' | escape }}" loading="lazy" decoding="async">
    </div>
  </div>
</section>

<script>
  (function() {
    var nodes = document.querySelectorAll('[data-scroll-reveal]');
    if (!nodes.length) return;
    if (!('IntersectionObserver' in window)) {
      nodes.forEach(function(node) { node.classList.add('is-in-view'); });
      return;
    }
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-in-view');
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.15,
      rootMargin: '0px 0px -80px 0px'
    });
    nodes.forEach(function(node) { observer.observe(node); });
  })();
</script>

{% schema %}
{
  "name": "Scroll Reveal",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE SOVÈNE RELIEF PATCH" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Spürbare Linderung. Ohne Aufwand." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Klinisch erprobte TENS-Technologie in einem ultradünnen, kabellosen Gerät — entwickelt für den täglichen Einsatz im Büro, beim Sport oder zuhause." },
    { "type": "text", "id": "image_url", "label": "Image URL", "default": "https://cdn.shopify.com/s/files/1/1043/1103/0024/files/hf_20260604_234616_3cb26ac5-67af-48d9-8f89-8a9da93a4cba.png" },
    { "type": "text", "id": "image_alt", "label": "Image Alt", "default": "SOVÈNE Relief Patch" }
  ],
  "presets": [{ "name": "Scroll Reveal" }]
}
{% endschema %}
